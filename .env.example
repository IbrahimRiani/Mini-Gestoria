# Copia este archivo a .env y rellena los valores.
# La aplicación las lee internamente; el cliente nunca las ve en la interfaz.

# DeepSeek — lectura de facturas (JSON Mode). Sin valor → aviso de desarrollo + modo local.
VITE_DEEPSEEK_API_KEY=

# Supabase (opcional) — Project URL + anon public key (NUNCA la sb_secret_...).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
